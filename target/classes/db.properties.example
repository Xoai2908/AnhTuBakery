# Database Configuration Properties
# Copy this file to 'db.properties' in the same folder to activate MySQL database persistence.
# If 'db.properties' is not found, the application falls back to a file-based H2 database.

# Database URL
# For MySQL:
db.url=jdbc:mysql://localhost:3306/bakery_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# For H2 (Override to custom location if desired, default is ./data/bakery):
# db.url=jdbc:h2:./data/bakery;AUTO_SERVER=TRUE;MODE=MySQL

# Credentials
db.username=root
db.password=your_password_here

# JDBC Driver Class
db.driver=com.mysql.cj.jdbc.Driver
# For H2 (if overriding):
# db.driver=org.h2.Driver
